// Prisma schema for Production-Grade Financial Analytics Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  DEPOSIT
  WITHDRAWAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role        @default(USER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  portfolios   Portfolio[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Portfolio {
  id           String        @id @default(cuid())
  userId       String
  name         String
  cashBalance  Decimal       @default(0) @db.Decimal(18, 4)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("portfolios")
}

model Transaction {
  id             String          @id @default(cuid())
  portfolioId    String
  ticker         String          @db.VarChar(12)
  type           TransactionType
  units          Decimal         @db.Decimal(18, 4)
  pricePerUnit   Decimal         @db.Decimal(18, 4)
  amount         Decimal         @db.Decimal(18, 4) // units * pricePerUnit (or cash delta)
  date           DateTime
  notes          String?         @db.VarChar(500)
  
  // Concurrency & Idempotency Controls
  version        Int             @default(1) // Optimistic Concurrency Control (OCC)
  idempotencyKey String?         @unique     // Duplicate submission prevention

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  portfolio      Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  auditLogs      AuditLog[]

  // Indexes optimized for 100,000+ records
  @@index([portfolioId, date(sort: Desc)])
  @@index([portfolioId, type])
  @@index([portfolioId, ticker])
  @@map("transactions")
}

model AuditLog {
  id            String      @id @default(cuid())
  userId        String
  transactionId String?
  action        AuditAction
  entityType    String      @default("TRANSACTION")
  entityId      String
  beforeState   Json?
  afterState    Json?
  createdAt     DateTime    @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityId])
  @@map("audit_logs")
}

model MarketDataCache {
  id         String   @id // e.g. "MARKET_DATA_SNAPSHOT"
  payload    Json
  fetchedAt  DateTime
  isStale    Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("market_data_cache")
}

model FundHistoricalNav {
  id        String   @id @default(cuid())
  fundCode  String   @db.VarChar(30)
  fundName  String   @db.VarChar(100)
  date      DateTime
  nav       Decimal  @db.Decimal(12, 4)

  @@unique([fundCode, date])
  @@index([fundCode, date(sort: Asc)])
  @@map("fund_historical_nav")
}
